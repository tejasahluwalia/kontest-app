{
	"name": "@kontest/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./env": "./src/env.ts",
		"./schema": "./src/schema.ts",
		"./model": "./src/model.ts",
		"./utils": "./src/utils.ts"
	},
	"scripts": {
		"generate": "drizzle-kit generate",
		"push": "drizzle-kit push",
		"studio": "drizzle-kit studio",
		"db:up": "docker compose -f docker/docker-compose.yml up -d",
		"db:down": "docker compose -f docker/docker-compose.yml down",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"elysia": "catalog:",
		"nanoid": "catalog:",
		"pg": "catalog:",
		"typebox": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/pg": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:"
	}
}
