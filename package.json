{
	"name": "kontest-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"trustedDependencies": [
		"@biomejs/biome",
		"@tailwindcss/oxide",
		"esbuild"
	],
	"catalog": {
		"@elysia/eden": "2.0.0-beta.5",
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.23.1",
		"better-auth": "^1.7.0",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"elysia": "2.0.0-beta.6",
		"nanoid": "^6.0.1",
		"pg": "^8.23.0",
		"typebox": "^1.3.15",
		"typescript": "^7.0.2",
		"valibot": "^1.4.2"
	},
	"scripts": {
		"dev": "bun run --elide-lines=0 --env-file=.env --filter '*' dev",
		"dev:all": "bun run --elide-lines=0 --env-file=.env --filter '*' dev",
		"dev:client": "bun --env-file=.env --filter @kontest/client dev",
		"dev:server": "bun --env-file=.env --filter @kontest/server dev",
		"dev:docs": "bun --env-file=.env --filter @kontest/docs dev",
		"dev:auth": "bun --env-file=.env run ./scripts/dev-auth.ts",
		"build": "bun --env-file=.env --filter '@kontest/*' build",
		"build:all": "bun --env-file=.env --filter '@kontest/*' build",
		"build:client": "bun --env-file=.env --filter @kontest/client build",
		"build:server": "bun --env-file=.env --filter @kontest/server build",
		"build:docs": "bun --env-file=.env --filter @kontest/docs build",
		"preview:docs": "bun --env-file=.env --filter @kontest/docs preview",
		"lint": "biome check . --write",
		"lint:check": "biome check .",
		"typecheck": "bun --workspaces typecheck",
		"test": "bun test",
		"test:smoke": "bun --env-file=.env run ./scripts/smoke-test.ts",
		"test:browser": "bun --env-file=.env run ./scripts/e2e-browser.ts",
		"test:cdp": "bun --env-file=.env run ./scripts/cdp-runner.ts",
		"env:check": "bun run ./packages/env/src/check.ts",
		"env:sync": "bun run ./packages/env/src/check.ts --sync",
		"env:example": "bun run ./packages/env/src/check.ts --example",
		"check:all": "bun env:check && bun typecheck && biome check . && bun run build",
		"db:up": "docker compose -f packages/db/docker/docker-compose.yml up -d",
		"db:down": "docker compose -f packages/db/docker/docker-compose.yml down",
		"db:push": "bun --env-file=.env --filter @kontest/db push",
		"db:generate": "bun --env-file=.env --filter @kontest/db generate",
		"db:seed": "bun --env-file=.env --filter @kontest/db seed",
		"db:setup": "bun db:up && bun db:push && bun db:seed",
		"db:reset": "bun db:down && bun db:up && bun db:push && bun db:seed",
		"db:studio": "bun --env-file=.env --filter @kontest/db studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@kontest/db": "workspace:*",
		"@kontest/env": "workspace:*",
		"@types/bun": "catalog:",
		"@types/pg": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "catalog:",
		"playwright": "^1.62.1",
		"typescript": "catalog:"
	}
}
