{
	"name": "kontest-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"trustedDependencies": [
		"@biomejs/biome",
		"@tailwindcss/oxide",
		"esbuild"
	],
	"catalog": {
		"@elysia/eden": "2.0.0-beta.4",
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.23.1",
		"better-auth": "^1.7.0",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"elysia": "2.0.0-beta.4",
		"nanoid": "^6.0.1",
		"pg": "^8.23.0",
		"typebox": "^1.3.15",
		"typescript": "^7.0.2",
		"valibot": "^1.4.2"
	},
	"scripts": {
		"dev": "bun run --elide-lines=0 --env-file=.env --filter '*' dev",
		"dev:client": "bun --env-file=.env --filter @kontest/client dev",
		"dev:server": "bun --env-file=.env --filter @kontest/server dev",
		"dev:docs": "bun --env-file=.env --filter @kontest/docs dev",
		"build": "bun --env-file=.env --filter '@kontest/*' build",
		"build:client": "bun --env-file=.env --filter @kontest/client build",
		"build:server": "bun --env-file=.env --filter @kontest/server build",
		"build:docs": "bun --env-file=.env --filter @kontest/docs build",
		"preview:docs": "bun --env-file=.env --filter @kontest/docs preview",
		"lint": "biome check . --write",
		"typecheck": "bun --workspaces typecheck",
		"db:up": "docker compose -f packages/db/docker/docker-compose.yml up -d",
		"db:down": "docker compose -f packages/db/docker/docker-compose.yml down",
		"db:push": "bun --env-file=.env --filter @kontest/db push",
		"db:generate": "bun --env-file=.env --filter @kontest/db generate",
		"db:studio": "bun --env-file=.env --filter @kontest/db studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"typescript": "catalog:"
	}
}
