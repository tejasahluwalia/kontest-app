{
	"name": "kontest-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --parallel dev",
		"dev:client": "pnpm --filter @kontest/client dev",
		"dev:server": "pnpm --filter @kontest/server dev",
		"dev:docs": "pnpm --filter @kontest/docs dev",
		"build": "pnpm --filter \"@kontest/*\" build",
		"build:client": "pnpm --filter @kontest/client build",
		"build:server": "pnpm --filter @kontest/server build",
		"build:docs": "pnpm --filter @kontest/docs build",
		"preview:docs": "pnpm --filter @kontest/docs preview",
		"lint": "biome check . --write",
		"typecheck": "pnpm --filter \"@kontest/*\" typecheck",
		"db:up": "docker compose -f packages/db/docker/docker-compose.yml up -d",
		"db:down": "docker compose -f packages/db/docker/docker-compose.yml down",
		"db:push": "pnpm --filter @kontest/db push",
		"db:generate": "pnpm --filter @kontest/db generate",
		"db:studio": "pnpm --filter @kontest/db studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"typescript": "^7.0.2"
	}
}
